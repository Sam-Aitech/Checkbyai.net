/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # Content-Security-Policy is set by the Node server (server/securityHeaders.ts), which is the only
  # origin that serves this app. A second, weaker policy here would be intersected with it on hosts
  # that honour this file, so it is intentionally not declared.

/*.html
  Cache-Control: public, max-age=3600
  
/static/*
  Cache-Control: public, max-age=31536000
  
/*.js
  Cache-Control: public, max-age=31536000
  
/*.css  
  Cache-Control: public, max-age=31536000