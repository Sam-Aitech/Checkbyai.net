# ─────────────────────────────────────────────────────────────────────────────
# CheckByAI — Environment Variable Reference
# Copy to .env and fill in values before starting the server.
# Variables marked REQUIRED will cause the server to refuse to start if absent.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string (wss:// for serverless driver)
# REQUIRED
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Session / Security ────────────────────────────────────────────────────────

# Express session secret — use a long random string (e.g. openssl rand -hex 64)
# REQUIRED
SESSION_SECRET=

# 32-byte hex key for encrypting phone numbers at rest
# REQUIRED — generate with: openssl rand -hex 32
PHONE_ENCRYPTION_KEY=

# Salt for one-way hashing of IP addresses in the rate-limit table
# REQUIRED — generate with: openssl rand -hex 16
IP_HASH_SALT=

# HMAC secret for signing checkout session tokens
# REQUIRED — generate with: openssl rand -hex 32
CHECKOUT_HMAC_SECRET=

# Secret for signing daily digest payloads
# REQUIRED — generate with: openssl rand -hex 32
DIGEST_SIGNING_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────

# Stripe secret key (sk_live_... or sk_test_...)
# REQUIRED
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...)
# Optional — only needed if receiving Stripe webhook events
STRIPE_WEBHOOK_SECRET=

# ── Email — Brevo (transactional) ─────────────────────────────────────────────

# Brevo (formerly Sendinblue) API key for transactional email
# Optional — admin alerts and notification emails are skipped if absent
BREVO_API_KEY=

# ── Email — Resend ────────────────────────────────────────────────────────────

# Resend API key (alternative email provider)
# Optional
RESEND_API_KEY=

# ── SMS / WhatsApp — Twilio ───────────────────────────────────────────────────

# Twilio account SID and auth token
# Optional — SMS/WhatsApp notifications are skipped if absent
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Twilio WhatsApp-enabled phone number (format: whatsapp:+447700000000)
TWILIO_WHATSAPP_NUMBER=

# ── Google OAuth ──────────────────────────────────────────────────────────────

# Google OAuth 2.0 credentials for social login
# Optional — Google login button is hidden if absent
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI Services ───────────────────────────────────────────────────────────────

# OpenAI — used for daily digest headline generation and PDF analysis
# Optional — AI features degrade gracefully if absent
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
# Optional
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenRouter (multi-model proxy)
# Optional
AI_INTEGRATIONS_OPENROUTER_API_KEY=
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────

# Turnstile secret key for bot-protection on verification forms
# Optional — CAPTCHA is skipped if absent
TURNSTILE_SECRET_KEY=

# ── Redis (BullMQ job queue) ──────────────────────────────────────────────────

# Redis connection — sponsor monitor job falls back to inline execution if absent
# Defaults shown; omit entirely to run without Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Python backend (Scrapling fallback scraper) ───────────────────────────────

# URL of the Python Scrapling service used as a fallback for GOV.UK scraping
# Optional — cheerio is the primary scraper; Scrapling is the fallback
PYTHON_BACKEND_URL=http://localhost:8000

# ── Application URL ──────────────────────────────────────────────────────

# Public-facing origin (no trailing slash). Used in emails, sitemap, canonical tags.
# Defaults to https://checkbyai.net if not set.
APP_URL=https://checkbyai.net

# ── Admin ─────────────────────────────────────────────────────────────────────

# Email address to seed as the initial admin user on first startup
# Optional — admin user can also be created manually
ADMIN_EMAIL=

# ── Replit runtime (auto-injected, do not set manually) ───────────────────────

# These are set automatically by the Replit platform at runtime.
# Do not set them in .env — they are listed here for documentation only.
# REPLIT_DOMAINS=
# REPLIT_DEPLOYMENT=
# REPL_IDENTITY=
# REPLIT_CONNECTORS_HOSTNAME=
# WEB_REPL_RENEWAL=
