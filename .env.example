# ─────────────────────────────────────────────────────────────────────────────
# CheckByAI — Environment Variable Reference
# Copy to .env and fill in values before starting the server.
# Variables marked REQUIRED will cause the server to refuse to start if absent.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string (wss:// for serverless driver)
# REQUIRED
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Session / Security ────────────────────────────────────────────────────────

# Express session secret — use a long random string (e.g. openssl rand -hex 64)
# REQUIRED
SESSION_SECRET=

# 32-byte hex key for encrypting phone numbers at rest
# REQUIRED — generate with: openssl rand -hex 32
PHONE_ENCRYPTION_KEY=

# Salt for one-way hashing of IP addresses in the rate-limit table
# REQUIRED — generate with: openssl rand -hex 16
IP_HASH_SALT=

# HMAC secret for signing checkout session tokens
# REQUIRED — generate with: openssl rand -hex 32
CHECKOUT_HMAC_SECRET=

# Secret for signing daily digest payloads
# REQUIRED — generate with: openssl rand -hex 32
DIGEST_SIGNING_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────

# Stripe secret key (sk_live_... or sk_test_...)
# REQUIRED
STRIPE_SECRET_KEY=

# Stripe publishable key (pk_live_... or pk_test_...)
# REQUIRED on non-Replit hosts (Railway/Docker/etc). Without it,
# GET /api/stripe/publishable-key falls back to the Replit connector and 500s.
STRIPE_PUBLISHABLE_KEY=

# Stripe webhook signing secret (whsec_...)
# REQUIRED — without it every webhook 500s on signature verification and paid
# plan activations never get granted. Get it from Stripe Dashboard → Developers
# → Webhooks (or, on Replit, the Stripe connector's webhook configuration).
STRIPE_WEBHOOK_SECRET=

# ── Email — Brevo (transactional) ─────────────────────────────────────────────

# Brevo (formerly Sendinblue) API key for transactional email
# Optional — admin alerts and notification emails are skipped if absent
BREVO_API_KEY=

# ── Email — Resend ────────────────────────────────────────────────────────────

# Resend API key (primary email provider for notification engine)
# Optional
RESEND_API_KEY=

# ── Email — SendGrid ─────────────────────────────────────────────────────────

# SendGrid API key (fallback email provider if Resend fails)
# Optional
SENDGRID_API_KEY=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────

# VAPID keys for Web Push notifications (browser push notifications)
# Generate with: npx web-push generate-vapid-keys
# Optional — push notifications are disabled if absent
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Webhook signing ──────────────────────────────────────────────────────────

# HMAC secret for signing webhook notification payloads
# Optional — webhooks are HMAC-signed with this key if set
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# ── SMS / WhatsApp — Twilio ───────────────────────────────────────────────────

# Twilio account SID and auth token
# Optional — SMS/WhatsApp notifications are skipped if absent
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Twilio WhatsApp-enabled phone number (format: whatsapp:+447700000000)
TWILIO_WHATSAPP_NUMBER=

# ── Google OAuth ──────────────────────────────────────────────────────────────

# Google OAuth 2.0 credentials for social login
# Optional — Google login button is hidden if absent
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI Services ───────────────────────────────────────────────────────────────

# OpenAI — used for daily digest headline generation and PDF analysis
# Optional — AI features degrade gracefully if absent
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
# Optional
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenRouter (multi-model proxy)
# Optional
AI_INTEGRATIONS_OPENROUTER_API_KEY=
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────

# Turnstile secret key for bot-protection on verification forms
# Optional in dev — CAPTCHA is skipped if absent. REQUIRED IN PRODUCTION:
# without it every form accepts unthrottled automated traffic.
TURNSTILE_SECRET_KEY=

# ── Redis (BullMQ job queue) ──────────────────────────────────────────────────

# Redis connection — sponsor monitor job falls back to inline execution if absent
# Defaults shown; omit entirely to run without Redis.
# PRODUCTION: Redis is effectively REQUIRED — without it queues run inline on the
# web event loop, rate limits revert to per-process memory (N× the intended limit
# across replicas), and the shared cache degrades to a per-pod LRU.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── External cron (GitHub Actions sponsor-monitor-cron.yml) ────────────────────

# Bearer secret required by POST /api/ops/cron-ping and /api/ops/trigger.
# If unset the endpoint logs a warning and external cron is DISABLED.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Absolute origin (https://… , no path) of the deployed app that the GitHub
# Actions cron workflow pings. Used by the workflow only.
CRON_URL=

# ── Job budgets & callbacks ───────────────────────────────────────────────────

# Wall-clock budgets per background job (milliseconds) before the trigger
# endpoint kills the run. Defaults shown; set only to override.
# BUDGET_SPONSOR_MONITOR_MS=1500000
# BUDGET_JOB_ALERT_MS=900000
# BUDGET_ENRICHMENT_SEED_MS=600000
# BUDGET_ENRICHMENT_BATCH_MS=1800000
# BUDGET_NOTIFICATION_DRAIN_MS=600000

# Ops callback retries (exponential backoff from CALLBACK_RETRY_BASE_MS).
# CALLBACK_SIGNING_SECRET is REQUIRED whenever a job request includes
# `callbackUrl` — the endpoint 400s without it. Generate: openssl rand -hex 32
# CALLBACK_MAX_ATTEMPTS=3
# CALLBACK_RETRY_BASE_MS=500
# CALLBACK_TIMEOUT_MS=10000
CALLBACK_SIGNING_SECRET=

# ── Python backend (Scraper / enrichment sidecar) ─────────────────────────────

# URL of the Python FastAPI service (backend/ → run_backend.py, port 8000).
# Optional — cheerio is the primary scraper; the sidecar is fallback/enrichment.
# Node logs a boot-time health warning and marks the sidecar offline if absent.
PYTHON_BACKEND_URL=http://localhost:8000

# Companies House API key — enrichment calls go direct to the CH API when set;
# otherwise Node falls back to the Python sidecar. Get a key at
# https://developer.company-information.service.gov.uk/
# Optional — enrichment skips with 401s if absent everywhere.
COMPANIES_HOUSE_API_KEY=

# Sidecar-only variables (read by backend/main.py, enrichment_router.py):
# Origin allowlist for the sidecar's CORS (defaults to http://localhost:5000 —
# keep in sync with the Node whitelist in server/index.ts).
ALLOWED_ORIGINS=http://localhost:5000
# Licence-history (LSUK) base URL override — leave unset for the default.
LSUK_BASE_URL=
# Scratch dir for sidecar downloads (defaults to system temp).
TEMP_DIR=

# ── Application URL ──────────────────────────────────────────────────────

# Public-facing origin (no trailing slash). Used in emails, sitemap, canonical tags.
# Defaults to https://checkbyai.net if not set.
APP_URL=https://checkbyai.net

# ── Observability — Sentry ──────────────────────────────────────────────────────

# Server-side Sentry DSN from your Sentry project (Settings → Projects → Client Keys)
# Optional — leave blank to disable backend Sentry error/trace capture
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Browser Sentry DSN exposed to Vite client builds (usually same DSN as SENTRY_DSN)
# Optional — leave blank to disable frontend Sentry ErrorBoundary/error capture
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── Playwright E2E ────────────────────────────────────────────────────────────

# Base URL used by Playwright E2E tests (required locally; CI skips E2E if unset)
TEST_BASE_URL=http://127.0.0.1:5000

# Cloudflare Turnstile keys for E2E CAPTCHA flows (official test keys —
# these always pass). NOTE: these are the SAME TURNSTILE_SECRET_KEY /
# VITE_TURNSTILE_SITE_KEY variables defined above — uncomment to override
# your dev keys while running E2E, do not set both.
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Uploads / scratch ─────────────────────────────────────────────────────────

# Absolute path for multer upload scratch files (defaults to <cwd>/uploads).
# In Docker keep this on a mounted volume or point it at object storage;
# files are deleted after verification, but crashes can orphan them.
UPLOADS_DIR=

# ── Admin ─────────────────────────────────────────────────────────────────────

# Email address to seed as the initial admin user on first startup
# Optional — admin user can also be created manually.
# NOT a startup requirement: server/index.ts excludes it from fail-fast checks.
ADMIN_EMAIL=

# Expose /api/admin/metrics (process/queue/cache diagnostics). Off by default.
# Optional
ENABLE_ADMIN_METRICS_ROUTES=

# ── Runtime ───────────────────────────────────────────────────────────────────

# development | test | production. Controls fail-fast env validation, secure
# cookies, CORS/CSP/HSTS strictness, and Sentry release tagging.
# Set automatically by npm scripts (dev/start); set explicitly only for tests.
# NODE_ENV=

# ── Replit runtime (auto-injected, do not set manually) ───────────────────────

# These are set automatically by the Replit platform at runtime.
# Do not set them in .env — they are listed here for documentation only.
# REPLIT_DOMAINS=
# REPLIT_DEPLOYMENT=
# REPL_IDENTITY=
# REPLIT_CONNECTORS_HOSTNAME=
# WEB_REPL_RENEWAL=
