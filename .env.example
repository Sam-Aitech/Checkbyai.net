# ─────────────────────────────────────────────────────────────────────────────
# CheckByAI — Environment Variable Reference
# Copy to .env and fill in values before starting the server.
# Variables marked REQUIRED will cause the server to refuse to start if absent.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string (wss:// for serverless driver)
# REQUIRED
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Session / Security ────────────────────────────────────────────────────────

# Express session secret — use a long random string (e.g. openssl rand -hex 64)
# REQUIRED
SESSION_SECRET=

# 32-byte hex key for encrypting phone numbers at rest
# REQUIRED — generate with: openssl rand -hex 32
PHONE_ENCRYPTION_KEY=

# Salt for one-way hashing of IP addresses in the rate-limit table
# REQUIRED — generate with: openssl rand -hex 16
IP_HASH_SALT=

# HMAC secret for signing checkout session tokens
# REQUIRED — generate with: openssl rand -hex 32
CHECKOUT_HMAC_SECRET=

# Secret for signing daily digest payloads
# REQUIRED — generate with: openssl rand -hex 32
DIGEST_SIGNING_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────

# Stripe secret key (sk_live_... or sk_test_...)
# REQUIRED
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...)
# Optional — only needed if receiving Stripe webhook events
STRIPE_WEBHOOK_SECRET=

# ── Email — Brevo (transactional) ─────────────────────────────────────────────

# Brevo (formerly Sendinblue) API key for transactional email
# Optional — admin alerts and notification emails are skipped if absent
BREVO_API_KEY=

# ── Email — Resend ────────────────────────────────────────────────────────────

# Resend API key (primary email provider for notification engine)
# Optional
RESEND_API_KEY=

# ── Email — SendGrid ─────────────────────────────────────────────────────────

# SendGrid API key (fallback email provider if Resend fails)
# Optional
SENDGRID_API_KEY=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────

# VAPID keys for Web Push notifications (browser push notifications)
# Generate with: npx web-push generate-vapid-keys
# Optional — push notifications are disabled if absent
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Webhook signing ──────────────────────────────────────────────────────────

# HMAC secret for signing webhook notification payloads
# Optional — webhooks are HMAC-signed with this key if set
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# ── SMS / WhatsApp — Twilio ───────────────────────────────────────────────────

# Twilio account SID and auth token
# Optional — SMS/WhatsApp notifications are skipped if absent
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Twilio WhatsApp-enabled phone number (format: whatsapp:+447700000000)
TWILIO_WHATSAPP_NUMBER=

# ── Google OAuth ──────────────────────────────────────────────────────────────

# Google OAuth 2.0 credentials for social login
# Optional — Google login button is hidden if absent
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI Services ───────────────────────────────────────────────────────────────

# OpenAI — used for daily digest headline generation and PDF analysis
# Optional — AI features degrade gracefully if absent
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
# Optional
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenRouter (multi-model proxy)
# Optional
AI_INTEGRATIONS_OPENROUTER_API_KEY=
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────

# Turnstile secret key for bot-protection on verification forms
# Optional — CAPTCHA is skipped if absent
TURNSTILE_SECRET_KEY=

# ── Redis (BullMQ job queue) ──────────────────────────────────────────────────

# Redis connection — sponsor monitor job falls back to inline execution if absent
# Defaults shown; omit entirely to run without Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Document store (PDF handoff API → worker) ─────────────────────────────
# local = disk under UPLOADS_DIR/documents (single host or shared volume).
# s3    = S3-compatible bucket (AWS S3, Cloudflare R2, MinIO) — required when
#         API and worker run on different instances without a shared volume.
DOCUMENT_STORE_DRIVER=local
# UPLOADS_DIR=./uploads
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=checkbyai-documents
# S3_PREFIX=checkbyai-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ── Process role (split API / PDF worker deployments) ─────────────────────
# all (default, single-process dev) | api (HTTP only) | worker (PDF jobs only)
# PROCESS_ROLE=all

# ── Python backend (Scrapling fallback scraper) ───────────────────────────────

# URL of the Python Scrapling service used as a fallback for GOV.UK scraping
# Optional — cheerio is the primary scraper; Scrapling is the fallback
PYTHON_BACKEND_URL=http://localhost:8000

# ── Application URL ──────────────────────────────────────────────────────

# Public-facing origin (no trailing slash). Used in emails, sitemap, canonical tags.
# Defaults to https://checkbyai.net if not set.
APP_URL=https://checkbyai.net

# ── Observability — Sentry ──────────────────────────────────────────────────────

# Server-side Sentry DSN from your Sentry project (Settings → Projects → Client Keys)
# Optional — leave blank to disable backend Sentry error/trace capture
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Browser Sentry DSN exposed to Vite client builds (usually same DSN as SENTRY_DSN)
# Optional — leave blank to disable frontend Sentry ErrorBoundary/error capture
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── Playwright E2E ────────────────────────────────────────────────────────────

# Base URL used by Playwright E2E tests
TEST_BASE_URL=http://127.0.0.1:5000

# Cloudflare Turnstile site key for E2E CAPTCHA flows (test key recommended)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Cloudflare Turnstile secret key for E2E CAPTCHA flows (test key recommended)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Turnstile test bypass token used by E2E tests when required
PLAYWRIGHT_TURNSTILE_BYPASS_TOKEN=XXXX.DUMMY.TOKEN.XXXX

# ── Admin ─────────────────────────────────────────────────────────────────────

# Email address to seed as the initial admin user on first startup
# Optional — admin user can also be created manually
ADMIN_EMAIL=

# ── Replit runtime (auto-injected, do not set manually) ───────────────────────

# These are set automatically by the Replit platform at runtime.
# Do not set them in .env — they are listed here for documentation only.
# REPLIT_DOMAINS=
# REPLIT_DEPLOYMENT=
# REPL_IDENTITY=
# REPLIT_CONNECTORS_HOSTNAME=
# WEB_REPL_RENEWAL=
